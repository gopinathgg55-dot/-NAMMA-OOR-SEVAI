<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F3">

    <!-- பின்னணி வரைபடம் (Map View Placeholder) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D1D1D1"
        android:scaleType="centerCrop"
        android:contentDescription="Map Background" />
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Map View"
        android:textSize="24sp"
        android:textColor="#888888" />

    <!-- சவாரி புக் செய்வதற்கான கார்டு (Bottom Booking Card) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="நம்ம ஊர் சேவை"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="எங்கே செல்ல வேண்டும்?"
                android:textSize="16sp"
                android:textColor="#555555"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- பிக்-அப் செய்யும் இடம் -->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#EFEFEF"
                android:hint="பிக்-அப் இடம் (Pickup)"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <!-- இறங்கும் இடம் -->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#EFEFEF"
                android:hint="செல்லும் இடம் (Drop)"
                android:padding="12dp"
                android:layout_marginBottom="20dp" />

            <!-- புக் செய்யும் பட்டன் -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="சவாரியை புக் செய்"
                android:textSize="18sp"
                android:backgroundTint="#000000"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>

